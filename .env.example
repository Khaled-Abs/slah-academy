# Copy this file to config.local.js and fill in your real Supabase values.
# config.local.js is gitignored — never commit real keys.
#
# On Vercel, set these two variables in the project settings (Settings → Environment Variables).
# The buildCommand in vercel.json generates config.local.js from them automatically.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key